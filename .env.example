# Everything except the two API keys is generated by `pnpm setup` (add --dev-wallet for a laptop-only wallet).
FACILITATOR_SECRET=          # Stellar testnet key that submits x402 settlements
ISSUER_SECRET=               # issues the test asset tUSDC
MERCHANT_ADDRESS=            # G… account paid by the data endpoints
AGENT_SECRET=                # the agent's session key (ed25519 signer on the smart account)
NEXT_PUBLIC_TUSDC=           # C… contract of the tUSDC Stellar Asset Contract
NEXT_PUBLIC_AGENT_PUBKEY=    # hex public key of AGENT_SECRET, granted a rule on the owner's wallet
NEXT_PUBLIC_NTFY_TOPIC=      # message bus between the agent and the owner's phone

# --dev-wallet only: a smart account whose admin is a plain key, so `pnpm dev-approve` can stand in for the phone
WALLET_ADDRESS=
AGENT_RULE_ID=1
DEV_ADMIN_SECRET=

OPENAI_API_KEY=              # the agent's model
FINNHUB_API_KEY=             # free at finnhub.io, used by /api/data/stock
